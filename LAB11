#include <stdio.h>

int mobile(int a[], int dir[], int n)
{
    int mobile_prev = 0, mobile = 0;

    for(int i = 0; i < n; i++)
    {
        if(dir[a[i]-1] == 0 && i != 0)
        {
            if(a[i] > a[i-1] && a[i] > mobile_prev)
            {
                mobile = a[i];
                mobile_prev = mobile;
            }
        }

        if(dir[a[i]-1] == 1 && i != n-1)
        {
            if(a[i] > a[i+1] && a[i] > mobile_prev)
            {
                mobile = a[i];
                mobile_prev = mobile;
            }
        }
    }

    return mobile;
}

int position(int a[], int n, int mobile)
{
    for(int i = 0; i < n; i++)
    {
        if(a[i] == mobile)
            return i;
    }
    return -1;
}

void printPermutation(int a[], int n)
{
    for(int i = 0; i < n; i++)
        printf("%d ", a[i]);
    printf("\n");
}

int main()
{
    int n;

    printf("Enter value of n: ");
    scanf("%d", &n);

    int a[n], dir[n];

    // Initialize permutation and directions
    for(int i = 0; i < n; i++)
    {
        a[i] = i + 1;
        dir[i] = 0;   // 0 = LEFT, 1 = RIGHT
    }

    int fact = 1;
    for(int i = 1; i <= n; i++)
        fact *= i;

    printPermutation(a, n);

    for(int count = 1; count < fact; count++)
    {
        int m = mobile(a, dir, n);
        int pos = position(a, n, m);

        // Move mobile element
        if(dir[m-1] == 0)
        {
            int temp = a[pos];
            a[pos] = a[pos-1];
            a[pos-1] = temp;
            pos--;
        }
        else
        {
            int temp = a[pos];
            a[pos] = a[pos+1];
            a[pos+1] = temp;
            pos++;
        }

        // Reverse direction of larger elements
        for(int i = 0; i < n; i++)
        {
            if(a[i] > m)
                dir[a[i]-1] = !dir[a[i]-1];
        }

        printPermutation(a, n);
    }

    return 0;
}
